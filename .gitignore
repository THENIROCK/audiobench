/.DS_Store
.DS_Store

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.eggs/

# Editor / IDE
.cursor/
.pytest_cache/

# Build artifacts
/dist/
/build/

# Ad-hoc run outputs (`results/` itself is checked in for demo files;
# this only ignores generated `run-<hash>.json` artifacts.)
/results/run-*.json
/.audiobench-agent-tmp/

# mkdocs build output
/site/

# Local-only analytics artifacts (regenerated by scripts/analytics/dashboard.py).
# The version under docs/analytics/ IS checked in so mkdocs --strict has something to publish.
/analytics/dashboard.html
/analytics/dashboard-data.json
